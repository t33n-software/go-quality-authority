{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/t33n-software/go-quality-authority/main/schemas/quality-gate-config/v1/schema.json",
  "title": "Quality Gate Configuration",
  "description": "The canonical quality-gate configuration seam (git-governance.quality.json). Version 3 adds the controlled toolchain identity and the project data block to the gate contract. The schema is owned by the go-quality-authority home, strictly decoded, and proven by conformance vectors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "toolchain", "gates"],
  "properties": {
    "schemaVersion": {
      "const": 3,
      "description": "The canonical schema version."
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goVersion"],
      "properties": {
        "goVersion": {
          "type": "string",
          "pattern": "^(go)?[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
          "description": "The pinned Go toolchain version, for example 1.26.6."
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includeFamilies": { "$ref": "#/$defs/families" },
        "excludeFamilies": { "$ref": "#/$defs/families" }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "maxItems": 64,
            "items": { "type": "string" }
          },
          "timeout": {
            "type": "string",
            "description": "A positive Go duration such as 15m."
          },
          "workingDirectory": {
            "type": "string",
            "description": "A path relative to the repository root."
          },
          "includeFamilies": { "$ref": "#/$defs/families" },
          "excludeFamilies": { "$ref": "#/$defs/families" }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binaries": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package"],
            "properties": {
              "package": {
                "type": "string",
                "pattern": "^\\.?/[A-Za-z0-9_./-]+$"
              },
              "smoke": {
                "type": "array",
                "maxItems": 16,
                "items": { "type": "string" }
              }
            }
          }
        },
        "fuzz": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "target", "time"],
            "properties": {
              "package": {
                "type": "string",
                "pattern": "^\\.?/[A-Za-z0-9_./-]+$"
              },
              "target": {
                "type": "string",
                "pattern": "^Fuzz[A-Za-z0-9_]*$"
              },
              "time": {
                "type": "string",
                "description": "A fuzz execution budget such as 50000x or 30s."
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "families": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Branch families selected by a gate or the defaults block."
    }
  }
}
