{
  "schemaVersion": 4,
  "toolchain": { "language": "go", "version": "1.27.3" },
  "extends": [],
  "defaults": {
    "includeFamilies": ["feature", "fix", "docs", "refactor", "chore", "test", "perf", "hotfix"]
  },
  "gates": [
    {
      "name": "full-local-build",
      "command": "go",
      "args": ["run", "-mod=readonly", "./cmd/quality-gate"],
      "timeout": "15m"
    }
  ]
}
